{
  "name": "W5 - Dependencies and Correlation",
  "description": "Database calls, log volume and the correlation identifier across services.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{
    "name": "Dependencies",
    "widgets": [
      {"title":"Database calls by system","layout":{"column":1,"row":1,"width":4,"height":3},"visualization":{"id":"viz.pie"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Span WHERE db.system IS NOT NULL FACET db.system SINCE 1 hour ago"}]}},
      {"title":"Database latency p95","layout":{"column":5,"row":1,"width":8,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentile(duration.ms, 95) FROM Span WHERE db.system IS NOT NULL TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Slowest statements (p95)","layout":{"column":1,"row":4,"width":12,"height":3},"visualization":{"id":"viz.table"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentile(duration.ms, 95) AS 'p95 ms', count(*) AS 'calls' FROM Span WHERE db.system IS NOT NULL FACET name SINCE 1 hour ago LIMIT 15"}]}},
      {"title":"Spans by service","layout":{"column":1,"row":7,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Span FACET service.name TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Log volume by namespace","layout":{"column":7,"row":7,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Log FACET k8s.namespace.name TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Correlation identifier in application logs","layout":{"column":1,"row":10,"width":12,"height":3},"visualization":{"id":"viz.table"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT message FROM Log WHERE k8s.namespace.name = 'workshop' AND message LIKE '%correlationId%' SINCE 1 hour ago LIMIT 20"}]}}
    ]
  }]
}
