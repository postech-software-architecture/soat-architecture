{
  "name": "W5 - Dependencies and Correlation",
  "description": "Dependency failures and cross-component correlation.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{"name":"Dependencies","widgets":[
    {"title":"Database duration","layout":{"column":1,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentile(duration, 95) FROM DatastoreSegment FACET databaseCallCount TIMESERIES"}]}},
    {"title":"Integration errors","layout":{"column":7,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.integration.error.count) FROM Metric FACET integration TIMESERIES"}]}},
    {"title":"Correlated traces","layout":{"column":1,"row":4,"width":6,"height":3},"visualization":{"id":"viz.table"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Span FACET trace.id WHERE trace.id IS NOT NULL"}]}},
    {"title":"External calls","layout":{"column":7,"row":4,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Span FACET peer.service TIMESERIES"}]}}
  ]}]
}
