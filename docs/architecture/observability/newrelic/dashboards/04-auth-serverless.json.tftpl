{
  "name": "W5 - Auth Serverless",
  "description": "CPF authentication Lambda signals.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{"name":"Auth","widgets":[
    {"title":"CPF attempts","layout":{"column":1,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.auth.cpf.attempt.count) FROM Metric TIMESERIES"}]}},
    {"title":"CPF failures","layout":{"column":7,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.auth.cpf.failure.count) FROM Metric FACET outcome TIMESERIES"}]}},
    {"title":"Handler duration (p50/p95/p99)","layout":{"column":1,"row":4,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentile(workshop.auth.cpf.duration, 50, 95, 99) FROM Metric TIMESERIES SINCE 1 hour ago"}]}},
    {"title":"Failures by kind","layout":{"column":7,"row":4,"width":6,"height":3},"visualization":{"id":"viz.billboard"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.auth.cpf.failure.count) AS 'auth failures', sum(workshop.auth.database.error.count) AS 'database errors' FROM Metric SINCE 1 hour ago"}]}}
  ]}]
}
