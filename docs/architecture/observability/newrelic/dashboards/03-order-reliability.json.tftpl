{
  "name": "W5 - Ordem de Servico Reliability",
  "description": "Failure, recovery and processing reliability signals.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{"name":"Reliability","widgets":[
    {"title":"Processing errors by stage","layout":{"column":1,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.ordem_servico.processing.error.count) FROM Metric FACET stage TIMESERIES"}]}},
    {"title":"Integration errors","layout":{"column":7,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.integration.error.count) FROM Metric FACET integration TIMESERIES"}]}},
    {"title":"Error outcomes","layout":{"column":1,"row":4,"width":6,"height":3},"visualization":{"id":"viz.pie"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.ordem_servico.processing.error.count) FROM Metric FACET outcome"}]}},
    {"title":"Error rate","layout":{"column":7,"row":4,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentage(count(*), WHERE error IS true) FROM Transaction TIMESERIES"}]}}
  ]}]
}
