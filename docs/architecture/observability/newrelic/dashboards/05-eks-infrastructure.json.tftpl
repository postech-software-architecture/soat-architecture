{
  "name": "W5 - EKS Infrastructure",
  "description": "Cluster health from the NRDOT collector: nodes, pods and restarts.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{
    "name": "Infrastructure",
    "widgets": [
      {"title":"Node CPU usage","layout":{"column":1,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT average(k8s.node.cpu.usage) FROM Metric WHERE k8s.cluster.name = 'workshop-eks' FACET k8s.node.name TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Node memory working set","layout":{"column":7,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT average(k8s.node.memory.working_set) FROM Metric WHERE k8s.cluster.name = 'workshop-eks' FACET k8s.node.name TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Pods in the workshop namespace","layout":{"column":1,"row":4,"width":3,"height":3},"visualization":{"id":"viz.billboard"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT uniqueCount(k8s.pod.name) FROM Metric WHERE k8s.namespace.name = 'workshop' SINCE 30 minutes ago"}]}},
      {"title":"Pod CPU against its limit","layout":{"column":4,"row":4,"width":4,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT average(k8s.pod.cpu_limit_utilization) FROM Metric WHERE k8s.namespace.name = 'workshop' FACET k8s.pod.name TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Pod memory against its limit","layout":{"column":8,"row":4,"width":5,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT average(k8s.pod.memory_limit_utilization) FROM Metric WHERE k8s.namespace.name = 'workshop' FACET k8s.pod.name TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Pods by namespace","layout":{"column":1,"row":7,"width":6,"height":3},"visualization":{"id":"viz.table"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT uniqueCount(k8s.pod.name) AS 'pods' FROM Metric WHERE k8s.cluster.name = 'workshop-eks' FACET k8s.namespace.name SINCE 30 minutes ago"}]}},
      {"title":"Node CPU percentage","layout":{"column":7,"row":7,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT average(node.cpu.usage.percentage) FROM Metric FACET k8s.node.name TIMESERIES SINCE 1 hour ago"}]}}
    ]
  }]
}
