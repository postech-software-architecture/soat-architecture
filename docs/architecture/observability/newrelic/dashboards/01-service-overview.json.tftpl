{
  "name": "W5 - Service Overview",
  "description": "Golden signals for the workshop service, from OpenTelemetry spans.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{
    "name": "Overview",
    "widgets": [
      {"title":"Requests by HTTP status","layout":{"column":1,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Span WHERE service.name = 'workshop-service' AND span.kind = 'server' FACET http.response.status_code TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Latency p50 / p95 / p99","layout":{"column":7,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentile(duration.ms, 50, 95, 99) FROM Span WHERE service.name = 'workshop-service' AND span.kind = 'server' TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Errors (HTTP >= 400)","layout":{"column":1,"row":4,"width":3,"height":3},"visualization":{"id":"viz.billboard"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Span WHERE service.name = 'workshop-service' AND numeric(http.response.status_code) >= 400 SINCE 1 hour ago"}]}},
      {"title":"Error rate","layout":{"column":4,"row":4,"width":3,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentage(count(*), WHERE numeric(http.response.status_code) >= 400) FROM Span WHERE service.name = 'workshop-service' AND span.kind = 'server' TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Throughput per minute","layout":{"column":7,"row":4,"width":6,"height":3},"visualization":{"id":"viz.area"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT rate(count(*), 1 minute) FROM Span WHERE service.name = 'workshop-service' AND span.kind = 'server' TIMESERIES SINCE 1 hour ago"}]}},
      {"title":"Slowest endpoints (p95)","layout":{"column":1,"row":7,"width":12,"height":3},"visualization":{"id":"viz.table"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT percentile(duration.ms, 95) AS 'p95 ms', count(*) AS 'calls' FROM Span WHERE service.name = 'workshop-service' AND span.kind = 'server' FACET name SINCE 1 hour ago LIMIT 15"}]}}
    ]
  }]
}
