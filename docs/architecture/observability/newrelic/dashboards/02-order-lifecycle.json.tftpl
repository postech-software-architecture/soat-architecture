{
  "name": "W5 - Ordem de Servico Lifecycle",
  "description": "Business lifecycle and duration metrics for ordens de servico.",
  "permissions": "PUBLIC_READ_ONLY",
  "pages": [{"name":"Lifecycle","widgets":[
    {"title":"Created orders","layout":{"column":1,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.ordem_servico.created.count) FROM Metric FACET environment TIMESERIES"}]}},
    {"title":"Status duration","layout":{"column":7,"row":1,"width":6,"height":3},"visualization":{"id":"viz.line"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT average(workshop.ordem_servico.status.duration) FROM Metric FACET status TIMESERIES"}]}},
    {"title":"Orders by status","layout":{"column":1,"row":4,"width":6,"height":3},"visualization":{"id":"viz.table"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT count(*) FROM Transaction FACET status"}]}},
    {"title":"Processing failures","layout":{"column":7,"row":4,"width":6,"height":3},"visualization":{"id":"viz.billboard"},"rawConfiguration":{"nrqlQueries":[{"accountId":${account_id},"query":"SELECT sum(workshop.ordem_servico.processing.error.count) FROM Metric"}]}}
  ]}]
}
